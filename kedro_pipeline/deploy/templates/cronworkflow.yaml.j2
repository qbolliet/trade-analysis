[#
  CronWorkflow d'un point d'entrée : instancie le WorkflowTemplate avec son point d'entrée
  et sa durée maximale. Délimiteurs Jinja en crochets ; les accolades doubles sont des
  expressions Argo.
#]
# Fichier généré par `kedro trade render-argo --env [[ config.env ]]` : ne pas modifier à la main.
# Source : pipelines Kedro (tags des nœuds) et config/base/argo.yml (bloc `workflow`).
apiVersion: argoproj.io/v1alpha1
kind: CronWorkflow
metadata:
  name: [[ config.name ]]-[[ entry.settings.name ]]
  namespace: [[ config.namespace ]]
  labels:
[% for key, value in config.labels.items() %]
    [[ key ]]: [[ value | q ]]
[% endfor %]
    generated-by: kedro_pipeline.deploy.render
  annotations:
    trade-analysis/kedro-env: [[ config.env | q ]]
spec:
[% if schedule_field == "schedules" %]
  schedules: [ [[ entry.schedule | q ]] ]
[% else %]
  schedule: [[ entry.schedule | q ]]
[% endif %]
  timezone: [[ config.timezone ]]
  # Une exécution à la fois par point d'entrée ; l'exclusion entre cadences est le mutex
  # d'exécution du WorkflowTemplate
  concurrencyPolicy: [[ config.concurrency_policy ]]
  startingDeadlineSeconds: [[ entry.settings.starting_deadline_seconds ]]
  successfulJobsHistoryLimit: [[ entry.settings.history_limit ]]
  failedJobsHistoryLimit: [[ entry.settings.history_limit ]]
  workflowMetadata:
    labels:
      trade-analysis/entry-point: [[ entry.settings.name ]]
  workflowSpec:
    workflowTemplateRef: {name: [[ config.name ]]}
    # Surcharge du point d'entrée et de la durée maximale du template
    entrypoint: [[ entry.settings.name ]]
    activeDeadlineSeconds: [[ entry.settings.active_deadline_seconds ]]
